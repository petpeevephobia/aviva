<?xml version="1.0" encoding="utf-8"?>

<install type="component" version="1.5.0">
<name>Mad Blanks</name>
        <creationDate>March 1, 2011</creationDate>
        <author>Chris Hallett</author>
        <copyright>Copyright (C) 2006, 2007, 2008, 2009, 2010, 2011 Chris Hallett</copyright>
	<license>http://www.gnu.org/copyleft/gpl.html GNU General Public License version 2 or any later version</license>
        <authorEmail>chris@madblanks.org</authorEmail>
        <authorUrl>www.madblanks.org</authorUrl>
	<!-- file version 1.8.2 20100810 -->
        <version>1.4.2</version>
        <description>Give a quiz, survey, assessment, poll, or general purpose form (requires the Create Single Record module). After submission, display a thank you message, score, calculations, summary, statistics, pie chart and/or bar graph result to the website user. Data related to each form submission is (with default settings) stored in the database. Optionally, share submitted data and results on the front end. If you are not sure whether Mad Blanks can do what you want, there is a good chance it can. Please ask in the How Do I... section of the support forum at http://www.madblanks.org</description>
	
	<installfile>install.madblanks.php</installfile>
	<installfile>uninstall.madblanks.php</installfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">install.mysql.sql</file>
		</sql>
	</install>
	
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">uninstall.mysql.sql</file>
		</sql>
	</uninstall>
	
	<files>
		<filename>index.html</filename>
		<filename>madblanks.css</filename>
		<filename>madblanks.html.php</filename>
		<filename>madblanks.php</filename>
	</files>
	
	<administration>
		<menu>Mad Blanks</menu>
		
		<submenu>
		    <menu task="listrecords">Records</menu>
		    <menu task="listcategories">Categories</menu>
		    <menu task="popupreferencewindow">Open Categories Reference Window</menu>
		    <menu task="listscorescripts">Score Scripts</menu>
		    <menu task="editconfiguration">Edit Configuration Variables</menu>
   		</submenu>
		
		<files folder="admin">
			<filename>install.mysql.sql</filename>
			<filename>uninstall.mysql.sql</filename>
			<filename>install.madblanks.php</filename>
			<filename>uninstall.madblanks.php</filename>
			<filename>index.html</filename>
			<filename>admin.madblanks.html.php</filename>
			<filename>admin.madblanks.php</filename>
			<filename>madblanks.class.php</filename>
			<filename>madblanksconfig.php</filename>
			<filename>toolbar.madblanks.html.php</filename>
			<filename>toolbar.madblanks.php</filename>
			<filename>LICENSE.txt</filename>
			<filename>config.xml</filename>
			<folder>language</folder>
		</files>
		
	</administration>
	
</install>
